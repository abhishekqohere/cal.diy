FROM node:20-alpine AS runner

WORKDIR /app

# QEDIX CANARY: fake deployment secret build arg.
# BUG: secret-like build args should not be persisted into Docker image ENV/layers.
ARG QEDIX_FAKE_DEPLOY_TOKEN
ARG QEDIX_FAKE_DATABASE_PASSWORD

# BUG: these values are copied into image environment variables.
# In a real deployment this could expose secrets through image inspect, build cache,
# runtime environment, logs, or pushed container layers.
ENV QEDIX_FAKE_DEPLOY_TOKEN=$QEDIX_FAKE_DEPLOY_TOKEN
ENV QEDIX_FAKE_DATABASE_PASSWORD=$QEDIX_FAKE_DATABASE_PASSWORD

RUN echo "Qedix Area 27.1 Dockerfile exposes secrets canary" > /app/qedix-area-27.txt

HEALTHCHECK CMD node -e "process.exit(0)"

CMD ["node", "-e", "console.log('Qedix Area 27.1 canary container')"]
